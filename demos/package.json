{
  "name": "@fabricator-ui/demos",
  "private": true,
  "description": "Commands for the demos. Run one from the repository root with `bun run demo <command>`.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "turbo run typecheck format:check test --filter=\"./demos/*\" --cwd=.. && bun run test && bun run --cwd react-native typecheck",
    "test": "vitest run",
    "react": "bun run --cwd react dev",
    "react:build": "bun run --cwd react build",
    "react:preview": "bun run --cwd react preview",
    "react:check": "bun run --cwd react check",
    "react:check:browser": "bun run --cwd react check:browser",
    "electron": "bun run --cwd electron dev",
    "tauri:desktop": "bun run --cwd tauri desktop",
    "tauri:ios": "bun run --cwd tauri ios",
    "tauri:ipad": "bun run --cwd tauri ipad",
    "tauri:android": "bun run --cwd tauri android",
    "tauri:check": "bun run --cwd tauri check",
    "tauri:build:ios": "bun run --cwd tauri build:ios",
    "tauri:build:android": "bun run --cwd tauri build:android",
    "react-native:ios": "bun install --cwd react-native && bun run --cwd react-native ios",
    "react-native:ipad": "bun install --cwd react-native && bun run --cwd react-native ipad",
    "react-native:android": "bun install --cwd react-native && bun run --cwd react-native android",
    "react-native:check": "bun run --cwd react-native check:screens",
    "swiftui:ios": "bun run --cwd swiftui ios",
    "swiftui:ipad": "bun run --cwd swiftui ipad",
    "swiftui:macos": "bun run --cwd swiftui macos",
    "swiftui:check:ios": "bun run --cwd swiftui check:ios",
    "swiftui:check:macos": "bun run --cwd swiftui check:macos",
    "swiftui:check:ui": "bun run --cwd swiftui check:ui",
    "swiftui:build:ios": "bun run --cwd swiftui build:ios",
    "swiftui:build:macos": "bun run --cwd swiftui build:macos",
    "compose:android": "bun run --cwd compose android",
    "compose:tablet": "bun run --cwd compose tablet",
    "compose:desktop": "bun run --cwd compose desktop",
    "compose:check:android": "bun run --cwd compose check:android",
    "compose:check:desktop": "bun run --cwd compose check:desktop",
    "compose:build:android": "bun run --cwd compose build:android",
    "compose:build:desktop": "bun run --cwd compose build:desktop"
  }
}
