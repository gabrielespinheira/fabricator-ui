{
  "name": "@fabricator-ui/icons-static",
  "version": "0.9.0",
  "description": "Fabricator Icons as SVG files, a sprite, JSON data and SVG strings, plus a PNG exporter for desktop apps.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://fabricator-ui.vercel.app/icons",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielespinheira/fabricator-ui",
    "directory": "packages/icons-static"
  },
  "bugs": {
    "url": "https://github.com/gabrielespinheira/fabricator-ui/issues"
  },
  "keywords": [
    "fabricator-ui",
    "icons",
    "duotone",
    "brand-icons",
    "svg",
    "sprite"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "bin": {
    "fabricator-icons": "./dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./brands": {
      "import": {
        "types": "./dist/esm/brands.d.ts",
        "default": "./dist/esm/brands.js"
      },
      "require": {
        "types": "./dist/cjs/brands.d.ts",
        "default": "./dist/cjs/brands.js"
      }
    },
    "./nodes": {
      "import": {
        "types": "./dist/esm/nodes.d.ts",
        "default": "./dist/esm/nodes.js"
      },
      "require": {
        "types": "./dist/cjs/nodes.d.ts",
        "default": "./dist/cjs/nodes.js"
      }
    },
    "./icons/*.svg": "./icons/*.svg",
    "./brands/*.svg": "./brands/*.svg",
    "./sprite.svg": "./sprite.svg",
    "./brands-sprite.svg": "./brands-sprite.svg",
    "./icon-nodes.json": "./icon-nodes.json",
    "./icon-scales.json": "./icon-scales.json",
    "./brand-nodes.json": "./brand-nodes.json",
    "./tags.json": "./tags.json",
    "./package.json": "./package.json",
    "./files": {
      "import": {
        "types": "./dist/esm/files.d.ts",
        "default": "./dist/esm/files.js"
      },
      "require": {
        "types": "./dist/cjs/files.d.ts",
        "default": "./dist/cjs/files.js"
      }
    },
    "./files/*.svg": "./files/*.svg",
    "./files-sprite.svg": "./files-sprite.svg",
    "./fill": {
      "import": {
        "types": "./dist/esm/fill.d.ts",
        "default": "./dist/esm/fill.js"
      },
      "require": {
        "types": "./dist/cjs/fill.d.ts",
        "default": "./dist/cjs/fill.js"
      }
    },
    "./fill/*": {
      "import": {
        "types": "./dist/esm/generated/fill/*.d.ts",
        "default": "./dist/esm/generated/fill/*.js"
      },
      "require": {
        "types": "./dist/cjs/generated/fill/*.d.ts",
        "default": "./dist/cjs/generated/fill/*.js"
      }
    },
    "./duotone": {
      "import": {
        "types": "./dist/esm/duotone.d.ts",
        "default": "./dist/esm/duotone.js"
      },
      "require": {
        "types": "./dist/cjs/duotone.d.ts",
        "default": "./dist/cjs/duotone.js"
      }
    },
    "./duotone/*": {
      "import": {
        "types": "./dist/esm/generated/duotone/*.d.ts",
        "default": "./dist/esm/generated/duotone/*.js"
      },
      "require": {
        "types": "./dist/cjs/generated/duotone/*.d.ts",
        "default": "./dist/cjs/generated/duotone/*.js"
      }
    },
    "./variants": {
      "import": {
        "types": "./dist/esm/variants.d.ts",
        "default": "./dist/esm/variants.js"
      },
      "require": {
        "types": "./dist/cjs/variants.d.ts",
        "default": "./dist/cjs/variants.js"
      }
    },
    "./svg": {
      "import": {
        "types": "./dist/esm/svg.d.ts",
        "default": "./dist/esm/svg.js"
      },
      "require": {
        "types": "./dist/cjs/svg.d.ts",
        "default": "./dist/cjs/svg.js"
      }
    }
  },
  "files": [
    "dist",
    "icons",
    "brands",
    "sprite.svg",
    "brands-sprite.svg",
    "icon-nodes.json",
    "icon-scales.json",
    "brand-nodes.json",
    "tags.json",
    "LICENSE.md",
    "BRANDS.md",
    "files",
    "files-sprite.svg",
    "fill",
    "duotone"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun ./scripts/generate.ts",
    "build": "bun run generate && bun ./scripts/build.ts",
    "typecheck": "bun run generate && tsc --noEmit",
    "test": "bun run generate && vitest run",
    "format:write": "prettier --write \"{src,scripts}/**/*.ts\" \"!src/generated/**\" \"*.json\" \"README.md\" --cache",
    "format:check": "prettier --check \"{src,scripts}/**/*.ts\" \"!src/generated/**\" \"*.json\" \"README.md\" --cache"
  },
  "peerDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fabricator-ui/icons-core": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^20.19.0",
    "typescript": "^6.0.3",
    "vitest": "5.1.2"
  }
}
