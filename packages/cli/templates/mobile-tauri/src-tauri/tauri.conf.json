{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__APP_NAME_JSON__",
  "version": "0.1.0",
  "identifier": "__APP_IDENTIFIER__",
  "build": {
    "beforeDevCommand": {
      "script": "__PACKAGE_MANAGER__ run dev:tauri-mobile",
      "cwd": "../../web"
    },
    "beforeBuildCommand": {
      "script": "__PACKAGE_MANAGER__ run build:tauri-mobile",
      "cwd": "../../web"
    },
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "mobile" }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "iOS": { "minimumSystemVersion": "16.4" },
    "android": { "minSdkVersion": 24 }
  }
}
