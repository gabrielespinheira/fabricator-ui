{
  "name": "fabricator-ui",
  "version": "0.5.1",
  "description": "The Fabricator UI command-line tool: create projects and add components.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://fabricator-ui.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabrielespinheira/fabricator-ui",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/gabrielespinheira/fabricator-ui/issues"
  },
  "keywords": [
    "fabricator-ui",
    "components",
    "ui",
    "react",
    "tailwind",
    "base-ui",
    "radix-ui",
    "react-aria",
    "registry",
    "cli"
  ],
  "bin": {
    "fabricator-ui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ./scripts/build.ts",
    "start:dev": "bun ./src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:write": "prettier --write \"**/*.{ts,md}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,md}\" --cache"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "^14.0.3",
    "kleur": "^4.1.5",
    "shadcn": "4.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fabricator-ui/setup": "workspace:*",
    "@types/node": "^20.19.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
