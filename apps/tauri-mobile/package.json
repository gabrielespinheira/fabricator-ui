{
  "name": "@fabricator-ui/tauri-mobile",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 1420",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 1420",
    "ios": "bun ./scripts/mobile.ts ios",
    "ipad": "bun ./scripts/mobile.ts ipad",
    "android": "bun ./scripts/mobile.ts android",
    "build:ios": "bun ./scripts/mobile.ts build:ios",
    "build:android": "bun ./scripts/mobile.ts build:android",
    "check": "bun ./scripts/mobile.ts check",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:browser": "bun ./scripts/check-browser.ts",
    "check:assets": "bun ./scripts/check-assets.ts",
    "format:check": "prettier --check src scripts package.json tsconfig.json vite.config.ts vitest.config.ts index.html postcss.config.mjs README.md verification.md src-tauri/tauri.conf.json src-tauri/capabilities"
  },
  "dependencies": {
    "@fabricator-ui/icons": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "next-themes": "0.4.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.1",
    "puppeteer-core": "25.18.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
