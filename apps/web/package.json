{
  "name": "web",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/check-dev-port.mts 4000 && bun run icons:build && bun run icons:packages && next dev --turbopack --port 4000",
    "build": "bun run icons:packages && bun run registry:build && next build",
    "start": "next start --port 4000",
    "preview": "bun run registry:build && next build && next start --port 4000",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx}\" --cache",
    "icons:dev": "bun ./scripts/build-icons.ts --watch",
    "icons:build": "bun ./scripts/build-icons.ts",
    "icons:packages": "bun run --cwd ../../packages/icons build && bun run --cwd ../../packages/icons-static build",
    "registry:build": "bun ./scripts/build-registry.mts",
    "registry:native": "bun ./scripts/build-native-registry.mts",
    "platforms:generate": "bun ./scripts/build-platform-contract.mts",
    "registry:platforms": "bun ./scripts/build-native-platforms.mts",
    "native:parity": "bun ./scripts/check-native-parity.mts",
    "native:docs": "bun ./scripts/build-native-docs.mts",
    "registry:capture": "bun --conditions=react-server ./scripts/capture-registry.mts",
    "test": "vitest run",
    "postinstall": "fumadocs-mdx",
    "pages:capture": "bun ./scripts/capture-pages.mts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.105",
    "@ai-sdk/openai": "4.0.118",
    "@ai-sdk/react": "4.0.177",
    "@base-ui/react": "1.9.0",
    "@date-fns/tz": "1.5.0",
    "@daypicker/persian": "^10.0.2",
    "@dnd-kit/abstract": "0.5.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/react": "0.5.3",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fabricator-ui/icons": "workspace:*",
    "@fabricator-ui/icons-static": "workspace:*",
    "@fabricator-ui/setup": "workspace:*",
    "@faker-js/faker": "^10.6.0",
    "@formisch/react": "^1.2.0",
    "@fullcalendar/react": "7.1.5",
    "@hookform/resolvers": "^7.0.6",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@internationalized/date": "^3.12.4",
    "@paper-design/shaders-react": "^0.0.82",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.9.0",
    "@shadcn/helpers": "0.3.0",
    "@shadcn/react": "0.3.1",
    "@streamdown/code": "^2.0.0",
    "@tabler/icons-react": "^3.52.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/ai": "1.4.0",
    "@tanstack/ai-client": "1.1.0",
    "@tanstack/ai-react": "1.0.2",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@vercel/analytics": "^2.0.1",
    "ai": "7.0.173",
    "change-case": "^5.4.4",
    "chrono-node": "^2.10.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-hierarchy": "3.1.3",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "date-fns": "^4.4.0",
    "dedent": "^1.7.2",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "front-matter": "^4.0.2",
    "fumadocs-core": "16.19.3",
    "fumadocs-docgen": "3.2.0",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "16.19.3",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.2",
    "little-date": "^1.2.1",
    "lodash": "^4.18.1",
    "lru-cache": "^11.5.3",
    "lucide-react": "1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "nuqs": "^2.10.3",
    "postcss": "^8.5.33",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-qr-code": "^2.2.0",
    "react-resizable-panels": "^4.21.0",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "3.8.0",
    "refractor": "5.0.0",
    "rehype-pretty-code": "^0.14.6",
    "rimraf": "^6.1.4",
    "server-only": "^0.0.1",
    "shadcn": "4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "swr": "^2.5.1",
    "temporal-polyfill": "1.0.8",
    "ts-morph": "26.0.0",
    "valibot": "^1.5.0",
    "vaul": "1.1.2",
    "voice-glow": "0.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.6.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/lodash": "^4.17.27",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "baseline-browser-mapping": "^2.11.37",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "undici": "^8.12.4",
    "unist-builder": "4.0.0",
    "unist-util-visit": "^5.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "importOrder": [
      "^(react/(.*)$)|^(react$)",
      "^(next/(.*)$)|^(next$)",
      "<THIRD_PARTY_MODULES>",
      "",
      "^types$",
      "^@/types/(.*)$",
      "^@/config/(.*)$",
      "^@/lib/(.*)$",
      "^@/hooks/(.*)$",
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/registry/(.*)$",
      "^@/styles/(.*)$",
      "^@/app/(.*)$",
      "^@/www/(.*)$",
      "",
      "^[./]"
    ],
    "importOrderParserPlugins": [
      "typescript",
      "jsx",
      "decorators-legacy"
    ],
    "tailwindStylesheet": "./app/globals.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports",
      "prettier-plugin-tailwindcss"
    ]
  }
}
