{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      // Temp aliases: registry sources import @/app/(create)/* (ships
      // verbatim in published registry payloads) and a handful still use
      // the legacy @/app/(app)/create/* path. The files actually live under
      // app/(app)/(create)/*. Remove once the registry imports (and
      // payloads) are migrated to the real path.
      "@/app/(create)/*": ["./app/(app)/(create)/*"],
      "@/app/(app)/create/*": ["./app/(app)/(create)/*"],
      // Fabricator overlay files import shared libs as if they lived in each
      // base (the build substitutes them per base); see registry/fabricator.
      "@/registry/bases/*/lib/fluid-hover": [
        "./registry/fabricator/shared/lib/fluid-hover"
      ],
      "@/registry/bases/*/lib/sounds": [
        "./registry/fabricator/shared/lib/sounds"
      ],
      "@/registry/bases/*/lib/desktop-window": [
        "./registry/fabricator/shared/lib/desktop-window"
      ],
      "@/registry/bases/*/components/sound-effects": [
        "./registry/fabricator/shared/components/sound-effects"
      ],
      "@/registry/bases/*/ui/density": [
        "./registry/fabricator/shared/ui/density"
      ],
      "@/registry/bases/*/lib/app-shell-model": [
        "./registry/fabricator/shared/lib/app-shell-model"
      ],
      "@/registry/bases/*/lib/sidebar-model": [
        "./registry/fabricator/shared/lib/sidebar-model"
      ],
      "@/registry/bases/*/lib/date-input-model": [
        "./registry/fabricator/shared/lib/date-input-model"
      ],
      "@/registry/bases/*/lib/sortable": [
        "./registry/fabricator/shared/lib/sortable"
      ],
      // Every base overrides the Sidebar with a superset of upstream's API;
      // App Shell and App Nav use the additions (peek, status, actions…).
      "@/registry/bases/*/ui/sidebar": ["./registry/fabricator/*/ui/sidebar"],
      // Fabricator-exclusive components live only in the overlay, per base.
      "@/registry/bases/*/ui/app-shell": [
        "./registry/fabricator/*/ui/app-shell"
      ],
      "@/registry/bases/*/ui/tab-strip": [
        "./registry/fabricator/*/ui/tab-strip"
      ],
      "@/registry/bases/*/ui/app-nav": [
        "./registry/fabricator/*/ui/app-nav"
      ],
      "@/registry/bases/*/ui/workspace-switcher": [
        "./registry/fabricator/*/ui/workspace-switcher"
      ],
      "@/registry/bases/*/ui/user-menu": [
        "./registry/fabricator/*/ui/user-menu"
      ],
      "@/registry/bases/*/ui/date-input": [
        "./registry/fabricator/*/ui/date-input"
      ],
      "@/registry/bases/*/ui/number-field": [
        "./registry/fabricator/*/ui/number-field"
      ],
      // Shared blocks compose the overlay's Base UI components.
      "@/registry/bases/__base__/ui/sidebar": [
        "./registry/fabricator/base/ui/sidebar"
      ],
      "@/registry/bases/__base__/ui/app-shell": [
        "./registry/fabricator/base/ui/app-shell"
      ],
      "@/registry/bases/__base__/ui/tab-strip": [
        "./registry/fabricator/base/ui/tab-strip"
      ],
      "@/registry/bases/__base__/ui/app-nav": [
        "./registry/fabricator/base/ui/app-nav"
      ],
      "@/registry/bases/__base__/ui/workspace-switcher": [
        "./registry/fabricator/base/ui/workspace-switcher"
      ],
      "@/registry/bases/__base__/ui/user-menu": [
        "./registry/fabricator/base/ui/user-menu"
      ],
      // Shared overlay files name the base as __base__ (the build substitutes
      // each base); they typecheck against the Base UI tree, then the overlay.
      "@/registry/bases/__base__/*": [
        "./registry/bases/base/*",
        "./registry/fabricator/shared/*"
      ],
      "@/*": ["./*"],
      "react": ["./node_modules/@types/react"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "scripts/build-registry.mts",
    "next.config.mjs",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "registry/native/ui",
    "registry/native/components",
    "registry/native/blocks",
    "registry/native/hooks",
    "registry/native/lib/*.tsx",
    "registry/native/lib/motion.ts",
    "registry/native/lib/apply-look.ts",
    "registry/native/lib/sounds.ts",
    "registry/native/lib/field-model.ts",
    "registry/native/lib/field-frame.ts",
    "examples/native",
    "styles/native"
  ]
}
