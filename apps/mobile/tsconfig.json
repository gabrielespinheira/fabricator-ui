{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@fabricator-ui/app-shell-model": [
        "../web/registry/fabricator/shared/lib/app-shell-model.ts"
      ],
      "@fabricator-ui/icons-react-native": [
        "../../packages/icons-react-native/dist/esm/index.d.ts"
      ],
      "@fabricator-ui/icons-react-native/brands": [
        "../../packages/icons-react-native/dist/esm/brands.d.ts"
      ],
      "@/registry/fabricator/*": ["../web/registry/fabricator/*"],
      "@/registry/native/*": ["../web/registry/native/*"],
      "@/examples/native/*": ["../web/examples/native/*"],
      "@/lib/component-groups": ["../web/lib/component-groups.ts"],
      "@/lib/component-explorer": ["../web/lib/component-explorer.ts"],
      "@/lib/icon-explorer": ["../web/lib/icon-explorer.ts"],
      "@fabricator-ui/icons/catalog": [
        "../../packages/icons/dist/esm/catalog.d.ts"
      ],
      "@fabricator-ui/icons-static/nodes": [
        "../../packages/icons-static/dist/esm/nodes.d.ts"
      ],
      "@fabricator-ui/icons-react-native/files": [
        "../../packages/icons-react-native/dist/esm/files.d.ts"
      ]
    }
  },
  "include": [
    "index.ts",
    "src",
    "../web/registry/native/**/*.ts",
    "../web/registry/native/**/*.tsx",
    "../web/examples/native/**/*.tsx"
  ],
  "exclude": [
    "../web/registry/native/_registry.ts",
    "../web/registry/native/items",
    "../web/registry/native/**/*.test.ts"
  ]
}
