{
  "expo": {
    "name": "Fabricator UI",
    "slug": "fabricator-ui-mobile",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "app.fabricator-ui.mobile",
      "supportsTablet": true
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf"
          ]
        }
      ]
    ],
    "scheme": "fabricator-ui",
    "android": {
      "package": "app.fabricator_ui.mobile"
    },
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
