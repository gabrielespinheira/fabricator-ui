    "desktop": "bun run scripts/run.ts desktop",
    "desktop:build": "bun run scripts/run.ts build-desktop",
    "desktop:check": "bun run scripts/run.ts check-desktop",
    "build:desktop": "bun run scripts/run.ts build-desktop",
    "check:desktop": "bun run scripts/run.ts check-desktop",
    "check": "bun run scripts/run.ts check",
    "check:source": "bun run scripts/check-source.ts",
    "typecheck": "bun ../../node_modules/typescript/bin/tsc -p tsconfig.json",
