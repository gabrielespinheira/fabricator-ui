{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts"],
  "exclude": [
    "scripts/editor-engine.ts",
    "scripts/calendar-engine.ts",
    "scripts/document-engine.ts",
    "scripts/date-picker-engine.ts"
  ]
}
