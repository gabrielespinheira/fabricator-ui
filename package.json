{
  "name": "fabricator-ui-monorepo",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/web",
    "demos/electron",
    "demos/react",
    "demos/tauri",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "demo": "bun run --cwd demos",
    "build": "turbo run build --filter=\"!./demos/*\"",
    "registry:build": "bun run --filter web registry:build",
    "react:build": "bun run --cwd apps/web registry:build --registry base-fabricator && bun run --cwd apps/web react:build",
    "react-native:build": "bun run --cwd apps/web registry:native && bun run --cwd apps/web react-native:build",
    "cli": "bun ./packages/cli/src/index.ts",
    "cli:build": "bun run --filter fabricator-ui build",
    "lint": "turbo run lint --filter=\"!./demos/*\"",
    "typecheck": "turbo run typecheck --filter=\"!./demos/*\"",
    "format:write": "turbo run format:write --filter=\"!./demos/*\"",
    "format:check": "turbo run format:check --filter=\"!./demos/*\"",
    "check": "turbo run lint typecheck format:check --filter=\"!./demos/*\"",
    "test": "turbo run test --filter=\"!./demos/*\"",
    "test:parity": "bun ./scripts/test-parity.ts",
    "test:scripts": "vitest run --dir scripts",
    "test:e2e": "bun run --filter @fabricator-ui/tests test:e2e",
    "sync:upstream": "bun ./scripts/sync-upstream.ts",
    "release:check": "bun ./scripts/check-versions.ts",
    "release:publish": "./scripts/publish.sh",
    "deploy": "./scripts/deploy.sh",
    "rebrand": "bun ./scripts/rebrand.ts",
    "icons:sync": "bun ./packages/icons-core/scripts/sync-lucide.ts",
    "icons:animated": "bun ./packages/icons-core/scripts/sync-animated.ts",
    "icons:audit": "bun run --cwd packages/icons audit:animated",
    "release:icons": "./scripts/publish-icons.sh",
    "icons:brands": "bun ./packages/icons-core/scripts/import-brands.ts",
    "icons:check": "bun ./packages/icons-core/scripts/check.ts",
    "icons:sheet": "bun ./packages/icons-core/scripts/sheet.ts",
    "icons:files": "bun ./packages/icons-core/scripts/sync-files.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "^22.20.5",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.11.13",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "prettier": "3.6.2",
    "mdast-util-to-markdown": "2.1.2",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
