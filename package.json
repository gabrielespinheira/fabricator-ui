{
  "name": "fabricator-ui-monorepo",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/desktop",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "desktop": "bun run --cwd apps/desktop electron",
    "desktop:tauri": "bun run --cwd apps/desktop tauri",
    "mobile": "bun install --cwd apps/mobile && bun run --cwd apps/mobile ios",
    "mobile:ipad": "bun install --cwd apps/mobile && bun run --cwd apps/mobile ipad",
    "mobile:android": "bun install --cwd apps/mobile && bun run --cwd apps/mobile android",
    "build": "turbo run build",
    "registry:build": "bun run --filter web registry:build",
    "cli": "bun ./packages/cli/src/index.ts",
    "cli:build": "bun run --filter fabricator-ui build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck format:check",
    "test": "turbo run test",
    "test:parity": "bun ./scripts/test-parity.ts",
    "test:e2e": "bun run --filter @fabricator-ui/tests test:e2e",
    "sync:upstream": "bun ./scripts/sync-upstream.ts",
    "changeset": "changeset",
    "release": "changeset version",
    "release:publish": "./scripts/publish.sh",
    "deploy": "./scripts/deploy.sh",
    "rebrand": "bun ./scripts/rebrand.ts",
    "icons:sync": "bun ./packages/icons-core/scripts/sync-lucide.ts",
    "icons:animated": "bun ./packages/icons-core/scripts/sync-animated.ts",
    "icons:audit": "bun run --cwd packages/icons audit:animated",
    "release:icons": "./scripts/publish-icons.sh",
    "icons:brands": "bun ./packages/icons-core/scripts/import-brands.ts",
    "icons:check": "bun ./packages/icons-core/scripts/check.ts",
    "icons:sheet": "bun ./packages/icons-core/scripts/sheet.ts",
    "icons:files": "bun ./packages/icons-core/scripts/sync-files.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "4.6.1",
    "@types/node": "^22.10.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "prettier": "3.6.2",
    "mdast-util-to-markdown": "2.1.2",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
