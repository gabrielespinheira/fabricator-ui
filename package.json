{
  "name": "fabricator-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "registry:build": "bun run --filter web registry:build",
    "cli": "bun ./packages/cli/src/index.ts",
    "cli:build": "bun run --filter fabricator-ui build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck format:check",
    "test": "turbo run test",
    "test:parity": "bun ./scripts/test-parity.ts",
    "test:e2e": "bun run --filter @fabricator-ui/tests test:e2e",
    "sync:upstream": "bun ./scripts/sync-upstream.ts",
    "changeset": "changeset",
    "release": "changeset version",
    "release:publish": "./scripts/publish.sh",
    "rebrand": "bun ./scripts/rebrand.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@ianvs/prettier-plugin-sort-imports": "4.6.1",
    "@types/node": "^22.10.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.9.18",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "prettier": "3.6.2",
    "mdast-util-to-markdown": "2.1.2",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
