{
  "name": "fabricator-ui-monorepo",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/desktop",
    "apps/kotlin",
    "apps/swiftui",
    "apps/tauri-mobile",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "example:web": "bun run dev",
    "example:desktop-electron": "bun run --cwd apps/desktop electron",
    "example:desktop-tauri": "bun run --cwd apps/desktop tauri",
    "example:mobile-reactnative": "bun run example:mobile-reactnative:ios",
    "example:mobile-reactnative:ios": "bun install --cwd apps/mobile && bun run --cwd apps/mobile ios",
    "example:mobile-reactnative:ipad": "bun install --cwd apps/mobile && bun run --cwd apps/mobile ipad",
    "example:mobile-reactnative:android": "bun install --cwd apps/mobile && bun run --cwd apps/mobile android",
    "example:mobile-reactnative:check": "bun run --cwd apps/mobile check:screens",
    "example:mobile-tauri": "bun run example:mobile-tauri:ios",
    "example:mobile-tauri:ios": "bun run --cwd apps/tauri-mobile ios",
    "example:mobile-tauri:ipad": "bun run --cwd apps/tauri-mobile ipad",
    "example:mobile-tauri:android": "bun run --cwd apps/tauri-mobile android",
    "example:mobile-tauri:check": "bun run --cwd apps/tauri-mobile check",
    "example:mobile-tauri:build:ios": "bun run --cwd apps/tauri-mobile build:ios",
    "example:mobile-tauri:build:android": "bun run --cwd apps/tauri-mobile build:android",
    "example:mobile-tauri:web": "bun run --cwd apps/tauri-mobile dev",
    "example:mobile-swiftui": "bun run example:mobile-swiftui:ios",
    "example:mobile-swiftui:ios": "bun run --cwd apps/swiftui ios",
    "example:mobile-swiftui:ipad": "bun run --cwd apps/swiftui ipad",
    "example:mobile-swiftui:check": "bun run --cwd apps/swiftui check:ios",
    "example:mobile-swiftui:check:ui": "bun run --cwd apps/swiftui check:ui",
    "example:mobile-swiftui:build": "bun run --cwd apps/swiftui build:ios",
    "example:desktop-swiftui": "bun run --cwd apps/swiftui macos",
    "example:desktop-swiftui:check": "bun run --cwd apps/swiftui check:macos",
    "example:desktop-swiftui:build": "bun run --cwd apps/swiftui build:macos",
    "example:mobile-kotlin": "bun run example:mobile-kotlin:android",
    "example:mobile-kotlin:android": "bun run --cwd apps/kotlin android",
    "example:mobile-kotlin:tablet": "bun run --cwd apps/kotlin android:tablet",
    "example:mobile-kotlin:check": "bun run --cwd apps/kotlin android:check",
    "example:mobile-kotlin:build": "bun run --cwd apps/kotlin android:build",
    "example:desktop-kotlin": "bun run --cwd apps/kotlin desktop",
    "example:desktop-kotlin:check": "bun run --cwd apps/kotlin desktop:check",
    "example:desktop-kotlin:build": "bun run --cwd apps/kotlin desktop:build",
    "desktop": "bun run example:desktop-electron",
    "desktop:tauri": "bun run example:desktop-tauri",
    "mobile": "bun run example:mobile-reactnative",
    "mobile:check": "bun run example:mobile-reactnative:check",
    "mobile:ipad": "bun run example:mobile-reactnative:ipad",
    "mobile:android": "bun run example:mobile-reactnative:android",
    "build": "turbo run build",
    "registry:build": "bun run --filter web registry:build",
    "platforms:generate": "bun run --cwd apps/web platforms:generate",
    "platforms:build": "bun run --cwd apps/web registry:platforms",
    "cli": "bun ./packages/cli/src/index.ts",
    "cli:build": "bun run --filter fabricator-ui build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format:write": "turbo run format:write",
    "format:check": "turbo run format:check",
    "check": "turbo run lint typecheck format:check",
    "test": "turbo run test",
    "test:parity": "bun ./scripts/test-parity.ts",
    "test:scripts": "vitest run --dir scripts",
    "test:e2e": "bun run --filter @fabricator-ui/tests test:e2e",
    "sync:upstream": "bun ./scripts/sync-upstream.ts",
    "release:check": "bun ./scripts/check-versions.ts",
    "release:publish": "./scripts/publish.sh",
    "deploy": "./scripts/deploy.sh",
    "rebrand": "bun ./scripts/rebrand.ts",
    "icons:sync": "bun ./packages/icons-core/scripts/sync-lucide.ts",
    "icons:animated": "bun ./packages/icons-core/scripts/sync-animated.ts",
    "icons:audit": "bun run --cwd packages/icons audit:animated",
    "release:icons": "./scripts/publish-icons.sh",
    "icons:brands": "bun ./packages/icons-core/scripts/import-brands.ts",
    "icons:check": "bun ./packages/icons-core/scripts/check.ts",
    "icons:sheet": "bun ./packages/icons-core/scripts/sheet.ts",
    "icons:files": "bun ./packages/icons-core/scripts/sync-files.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@ianvs/prettier-plugin-sort-imports": "4.6.1",
    "@types/node": "^22.20.5",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "^2.11.11",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "prettier": "3.6.2",
    "mdast-util-to-markdown": "2.1.2",
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
